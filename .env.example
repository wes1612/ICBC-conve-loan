# 复制为 .env 后填入真实值，.env 本身不要提交到 GitHub（已在 .gitignore 里）

# 大模型推理：默认使用 DeepSeek 托管 API。
# API Key 只放后端，不要使用 VITE_ 前缀或提交到 Git。
ICBC_AI_PROVIDER=deepseek
ICBC_AI_API_KEY=
ICBC_AI_MODEL=deepseek-v4-flash
# 可选：助手和报告分别选择模型；留空时继承 ICBC_AI_MODEL。
ICBC_AI_ASSISTANT_MODEL=
ICBC_AI_REPORT_MODEL=
ICBC_AI_TIMEOUT_SECONDS=30
ICBC_AI_THINKING=false
ICBC_AI_ASSISTANT_MAX_TOKENS=1200
ICBC_AI_REPORT_MAX_TOKENS=2200
# DeepSeek 默认自动使用 https://api.deepseek.com，可留空。
ICBC_AI_BASE_URL=

# 本地微调模型接入示例：
# ICBC_AI_PROVIDER=local
# ICBC_AI_MODEL=icbc-credit-assistant
# ICBC_AI_BASE_URL=http://127.0.0.1:9000/v1

# 数据库（MVP阶段可留空，默认用本地 SQLite）
DATABASE_URL=sqlite:///./backend/data/app.db

# 第三方数据源（如需要，按实际接入方补充）
MEITUAN_API_KEY=
ICBC_API_KEY=
