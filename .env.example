# 复制为 .env 后填入真实值，.env 本身不要提交到 GitHub（已在 .gitignore 里）

# 大模型 API（合同/评价解析、报告生成、风险原因归纳）
LLM_API_KEY=

# 数据库（MVP阶段可留空，默认用本地 SQLite）
DATABASE_URL=sqlite:///./backend/data/app.db

# 第三方数据源（如需要，按实际接入方补充）
MEITUAN_API_KEY=
ICBC_API_KEY=
ICBC_OPENAI_API_KEY=
ICBC_AI_MODEL=gpt-5.6-terra
ICBC_AI_TIMEOUT_SECONDS=30
# Optional OpenAI-compatible endpoint override; leave blank for OpenAI.
ICBC_AI_BASE_URL=
